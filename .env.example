SECRET_KEY=change-me
DATABASE_URL=sqlite:///dev.db
FLASK_DEBUG=1

# Optional — free tier available (Gemini 2.5 Flash: 10 req/min, 500 req/day, no card required).
# Without this key the app still runs: free-text AI parsing and the friendly summary
# are skipped gracefully, and the plain form/API still produce full estimates.
GEMINI_API_KEY=

# Telegram bot (optional; run `python -m bot.telegram_bot` to start it).
TELEGRAM_BOT_TOKEN=
ESTIMATE_API_URL=http://127.0.0.1:5000
